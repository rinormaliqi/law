# Copy to .env.local for local testing, and set the same values in
# Vercel → Project → Settings → Environment Variables for production.

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered (comma-separated for several)
CONTACT_TO_EMAIL=Asdren.bytyqi91@gmail.com

# Optional: where job applications (with CV) go. Falls back to CONTACT_TO_EMAIL.
CAREERS_TO_EMAIL=

# Sender. Leave empty to use Resend's test sender (onboarding@resend.dev),
# which only delivers to the email that owns the Resend account.
# After verifying bytyqipartners.com in Resend, set:
# CONTACT_FROM_EMAIL=Bytyqi & Partners <noreply@bytyqipartners.com>
CONTACT_FROM_EMAIL=
